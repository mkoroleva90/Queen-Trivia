{
  "expo": {
    "name": "Queen Trivia",
    "slug": "queen-trivia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0f15"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.queentrivia.app",
      "buildNumber": "1",
      "ITSAppUsesNonExemptEncryption": false,
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      }
    },
    "android": {
      "package": "com.queentrivia.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "privacyPolicyUrl": "https://queen-trivia.com/privacy",
    "supportUrl": "https://queen-trivia.com/support",
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://queen-trivia.com"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
