modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CAPACITOR_SERVER_URL = "https://mktrivia.com"
ENFORCE_FREE_TIER_LIMITS = "true"
FREE_TIER_AI_ACTIONS_PER_MONTH = "150"
FREE_TIER_GAMES_PER_MONTH = "20"
