# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# pnpm package metadata cache — can reach 200+ MB and causes 413 on layer push.
.cache/

# API server source maps — not needed at runtime, large files.
artifacts/api-server/dist/*.map

# Attached assets uploaded during development.
attached_assets/
